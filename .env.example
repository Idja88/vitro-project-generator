# Образец .env для backend/ (локально) или рядом с docker-compose.yml (сервер).
# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Среда: dev | prod | test ---------------------------------------------------
# prod: префикс URL, ProxyFix, Secure-cookie, без автологина
FLASK_CONFIG=prod

# --- Docker Compose ----------------------------------------------------------------
# Версия образа из ghcr.io (например 0.2.0) или latest
GENERATOR_VERSION=latest
GENERATOR_PORT=8000

# --- Только для prod: работа за nginx -------------------------------------------
PREFIX=/generator
SERVER_NAME=mp.example.kz
PROXY_COUNT=1

# --- Vitro-CAD MP --------------------------------------------------------------------
VITRO_CAD_API_BASE_URL=https://mp.example.kz
VITRO_CAD_API_TIMEOUT=30

# Только для dev: автологин, когда страница открыта не из Vitro-CAD. На сервере НЕ задавать.
# VITRO_CAD_ADMIN_USERNAME=
# VITRO_CAD_ADMIN_PASSWORD=

# --- Идентификаторы списков (GUID из Vitro-CAD) ------------------------------
PROJECT_LIST_ID=
MARK_LIST_ID=
OBJECT_LIST_ID=
DOCUMENT_LIST_ID=
RECYCLE_BIN_LIST_ID=
SCOPE_LIST_ID=

# --- Типы контента -------------------------------------------------------------------
PROJECT_CT_ID=
CUSTOMER_CT_ID=
OBJECT_CT_ID=
MARK_CT_ID=
SCOPE_CT_ID=
PROJECT_FOLDER_CT_ID=
OBJECT_FOLDER_CT_ID=
MARK_FOLDER_CT_ID=

# --- Шаблоны структуры ---------------------------------------------------------------
PROJECT_TEMPLATE_FOLDER_ID=
MARK_TEMPLATE_FOLDER_ID=
PROJECT_TEMPLATE_ANCHOR_NAME=

# --- Права ----------------------------------------------------------------------------
EDIT_PERMISSION_LEVEL_ID=

# --- Логирование ---------------------------------------------------------------------
LOG_LEVEL=INFO
# Файл лога с ротацией; в Docker обычно не нужен — логи идут в stdout (docker compose logs)
# LOG_FILE=vitro_project_generator.log
